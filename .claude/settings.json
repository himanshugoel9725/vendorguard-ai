{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "UV_PROJECT_ENVIRONMENT": ".venv.nosync"
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv add:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run vg:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(uv run python scripts/:*)",
      "Bash(bash scripts/check_no_hf.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(ollama list)",
      "Bash(docker compose ps:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Bash(cat .env:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
