# =============================================================================
#  VendorGuard AI - SECRETS ONLY.
#  cp .env.example .env      (.env is git-ignored - never commit it)
#  Names follow VG_<SECTION>__<KEY> and override config/settings.yaml.
#  Leave blank what you don't use: the default setup needs NO keys.
# =============================================================================

# --- REST API: the key clients send in the X-API-Key header -------------------
# generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VG_API__AUTH_KEY=

# --- Optional: hosted OpenAI-compatible LLM (llm.provider=openai_compat) ------
# A Gemini (Google AI Studio), Groq, OpenAI or OpenRouter key.
VG_LLM__OPENAI_COMPAT__API_KEY=

# --- Optional: Jev decision model (decision.provider=jev) ---------------------
VG_DECISION__JEV__API_KEY=

# --- Optional: Letta Cloud (memory.provider=letta + memory.letta.mode=cloud) --
# Spends Letta credits. Keep mode=self_hosted while developing.
VG_MEMORY__LETTA__API_KEY=

# --- Optional non-secret overrides (uncomment to use) -------------------------
# VG_LLM__PROVIDER=mock
# VG_LLM__MODEL=qwen2.5:3b
# VG_EMBEDDINGS__PROVIDER=none
# VG_DECISION__PROVIDER=llm_judge
# VG_MEMORY__PROVIDER=letta
